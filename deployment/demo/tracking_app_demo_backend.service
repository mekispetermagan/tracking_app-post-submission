[Unit]
Description=Progress Tracking fictional demo FastAPI backend
After=network.target

[Service]
User=trackingapp
Group=trackingapp
WorkingDirectory=/srv/tracking_app_demo/app/backend
EnvironmentFile=/srv/tracking_app_demo/.env
ExecStart=/srv/tracking_app_demo/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
